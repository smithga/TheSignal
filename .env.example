# Copy this file to .env and fill in your real values.
# Loaded by scripts/load-env.sh using the ASP.NET Core env var convention
# (double underscore "__" maps to config section nesting, e.g. Speech__Key -> Speech:Key).

SPEECH__KEY=
SPEECH__REGION=

FOUNDRY__ENDPOINT=
FOUNDRY__DEPLOYMENT=
FOUNDRY__APIKEY=
FOUNDRY__APIVERSION=2024-05-01-preview

AVATAR__CHARACTER=lisa
AVATAR__STYLE=casual-sitting
AVATAR__VOICE=en-US-AvaMultilingualNeural

ANAM__APIKEY=
ANAM__PERSONAID=
ANAM__AVATARID=
ANAM__AVATARMODEL=cara-4
ANAM__VOICEID=
ANAM__LLMID=

# Free local voice-rehearsal path (nothing here leaves the machine).
# Local voice mode needs the bridge running: tools/voice-bridge/service.py
# (bind to 127.0.0.1 — https://localhost pages can only fetch http from loopback).
LOCAL__BRIDGEENDPOINT=http://127.0.0.1:8002
# Leave OLLAMA__MODEL empty to keep the deterministic improvise stub;
# set it to a pulled chat model (e.g. evelyn, llama3.2:3b) for real local dialog.
OLLAMA__ENDPOINT=http://127.0.0.1:11434
OLLAMA__MODEL=
# Voice bridge tool locations (read by tools/voice-bridge/service.py).
# Piper binary + .onnx voice model; whisper.cpp CLI + ggml model.
# scripts/run-local-voice.sh checks these before starting anything.
PIPER_PATH=piper
PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
WHISPER_PATH=whisper-cli
WHISPER_MODEL=/path/to/ggml-base.en.bin
FFMPEG_PATH=ffmpeg
VOICE_BRIDGE_HOST=127.0.0.1
VOICE_BRIDGE_PORT=8002
